# Docker Compose 环境变量示例（复制为 .env 后填写真实值）
# .env 已被 .gitignore 忽略，请勿提交真实密码
#
# PowerShell:  Copy-Item .env.example .env
# Bash:        cp .env.example .env

# RabbitMQ 独立用户（默认 aiops）
RABBITMQ_USER=aiops

# RabbitMQ 密码（必填，缺失时 docker compose up 会直接报错）
RABBITMQ_PASSWORD=

# JWT 签名密钥（HS256，Base64 编码后至少 32 字节；缺失时应用启动直接报错）
# 生成方式（PowerShell）：
#   $b = New-Object byte[] 32
#   [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   [Convert]::ToBase64String($b)
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# 阿里云百炼（OpenAI 兼容 API）：留空时应用可启动，AI 接口返回 503
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
AI_MODEL=qwen-plus
AI_CONNECT_TIMEOUT=5000
AI_READ_TIMEOUT=60000
AI_MAX_OUTPUT_TOKENS=1500
